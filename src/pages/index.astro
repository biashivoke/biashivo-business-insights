    <header>
      <div class="container nav">
        <a href="/" class="brand">BIASHI<span>VO</span></a>
        <nav aria-label="Main navigation">
          <a href="#articles">Articles</a>
          <a href="#about">About</a>
         <a href="#early-access">Early Access</a>
        </nav>
      </div>
    </header>

    <main>
      <div class="hero">
        <div class="container">
          <div class="eyebrow">Biashivo Business Insights</div>
          <h1>Know your numbers.<br />Grow your business.</h1>
          <p>
            Practical business insights, financial guides, and useful resources
            to help Kenyan and African entrepreneurs make smarter decisions
            and build stronger businesses.
          </p>
          <a class="button" href="#articles">Explore Business Insights →</a>
        </div>
      </div>

      <section id="articles">
        <div class="container">
          <h2 class="section-title">Featured Business Insights</h2>
          <p class="section-intro">
            Simple, practical advice to help you manage money,
            understand your profits, and grow with confidence.
          </p>

          <div class="cards">
            {articles.map((article) => (
              <article class="card">
                <div class="card-icon" aria-hidden="true">{article.icon}</div>
                
<div class="category">{article.category}</div>
<h3>
  {article.url ? (
    <a href={article.url} class="article-link">
      {article.title} →
    </a>
  ) : (
    article.title
  )}
</h3>
<p>{article.description}</p>

              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="about" id="about">
        <div class="container">
          <h2 class="section-title">Why Biashivo Business Insights?</h2>
          <p>
            Running a small business requires more than making sales.
            Understanding expenses, tracking customer payments, and knowing
            your real profit are equally important.
          </p>
          <p>
            Biashivo Business Insights makes business knowledge easier to
            understand and apply, especially for entrepreneurs who manage
            their businesses using notebooks, spreadsheets, or WhatsApp.
          </p>
        </div>
      </section>

      <section class="coming-soon" id="early-access">
        <div class="container">
          <h2>Something Better Is Coming.</h2>
          <p>
            We're building Biashivo, a simple business management platform
            designed to help African SMEs manage sales, expenses, customers,
            orders, and profits in one place.
          </p>
