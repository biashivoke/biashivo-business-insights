  {
    category: "Business Growth",
    title: "Common Money Mistakes Small Business Owners Make",
    description: "Learn how to avoid everyday financial mistakes and make more informed business decisions.",
    icon: "📈",
url: "/articles/common-money-mistakes-small-business-owners-make",
